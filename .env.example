# Copy this file to .env and fill in whatever keys you have. All are optional.

# JSearch (RapidAPI) - pulls from Google for Jobs, which includes LinkedIn, Indeed,
# JobStreet, Glassdoor, ZipRecruiter... BEST source for local (Philippines) jobs.
# Free plan: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Jooble - aggregator with Philippine jobs. Free key: https://jooble.org/api/about
JOOBLE_API_KEY=

# Telegram alerts on your phone (optional). Create a bot with @BotFather,
# then message it once and get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3000
