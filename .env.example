# Copy this file to .env and fill in whatever keys you have. All are optional.

# JSearch (RapidAPI) - pulls from Google for Jobs, which includes LinkedIn, Indeed,
# JobStreet, Glassdoor, ZipRecruiter... BEST source for local (Philippines) jobs.
# Free plan: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Jooble - aggregator with Philippine jobs. Free key: https://jooble.org/api/about
JOOBLE_API_KEY=

# Telegram alerts on your phone (optional). Create a bot with @BotFather,
# then message it once and get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3000

# Protects the site with a password (strongly recommended when deployed online,
# otherwise anyone with the link can use up your API quota).
APP_PASSWORD=

# Search settings. These override config.json - on Netlify this is the ONLY way to set them.
KEYWORDS=developer, web developer, react
EXCLUDE=
LOCATION=Philippines
COUNTRY=ph
# INCLUDE_REMOTE=true
# DISABLED_SOURCES=arbeitnow
# KEEP_DAYS=30

# How often (minutes) to use your JSearch / Jooble quota. Each JSearch check uses
# 1 request per keyword (max 5). Default 360 = 4 checks a day.
# Monthly requests = (1440 / interval) x keywords x 30 - keep it under your plan's limit.
# JSEARCH_INTERVAL_MINUTES=360
# JOOBLE_INTERVAL_MINUTES=
